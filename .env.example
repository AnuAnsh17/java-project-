# Copy to .env and replace every CHANGE_ME value before starting Compose.
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
JWT_SECRET=CHANGE_ME_with_a_long_random_signing_secret_at_least_32_chars
APP_PORT=3000

# Optional: provision privileged demo accounts at first startup. Use institutional emails.
DEMO_ACCOUNTS_ENABLED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Campus Administrator
DEMO_FACULTY_EMAIL=
DEMO_FACULTY_PASSWORD=
DEMO_FACULTY_NAME=Campus Faculty
